---
interface Props { tags: string[]; accent?: string[]; class?: string }
const { tags, accent = [], class: cls = '' } = Astro.props;
---
<!-- Le point séparateur est un pseudo-élément (tag-list, global.css) : moins de nœuds DOM, rien de lu par les lecteurs d'écran -->
<ul class:list={['tag-list flex flex-wrap items-center gap-x-2.5 gap-y-1 font-tag', cls]}>
  {tags.map((t) => <li class={accent.includes(t) ? 'text-tonique' : ''}>{t}</li>)}
</ul>
