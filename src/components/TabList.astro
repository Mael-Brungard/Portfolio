---
interface Props { tabs: { id: string; label: string }[]; label: string }
const { tabs, label } = Astro.props;
---
<div role="tablist" aria-label={label} class="flex flex-wrap gap-3">
  {tabs.map((t, i) => (
    <button type="button" role="tab" id={`tab-${t.id}`} data-tab={t.id} aria-controls={`panel-${t.id}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1} class="tab font-corps">{t.label}</button>
  ))}
</div>
