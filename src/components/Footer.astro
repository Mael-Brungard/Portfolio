---
import { nav } from '../data/content';
interface Props { links?: { label: string; href: string }[] }
const { links = nav } = Astro.props;
---
<footer class="relative bg-[#24160d] px-5 pb-7 pt-10 lg:px-14 lg:pt-12">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-col gap-5">
      <p class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[.12em]"><span aria-hidden="true" class="size-2.5 rounded-full bg-tonique"></span>Portfolio</p>
      <p class="font-titre text-5xl leading-[.92] tracking-tight lg:text-[4rem]">Maël<br class="lg:hidden" /> BRUNGARD</p>
    </div>
    <nav aria-label="Pied de page" class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-3">
      <span class="text-[11px] font-semibold uppercase tracking-[.12em] text-tonique">Navigation</span>
      {links.map((l) => (
        <a href={l.href} class="group flex items-center py-1 font-tag text-xl font-medium transition-colors duration-300 hover:text-tonique">
          {l.label}
          <svg aria-hidden="true" viewBox="0 0 18 18" class="size-[1.125rem] text-tonique transition-transform duration-300 ease-soft group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 13 13 5M6 5h7v7" /></svg>
        </a>
      ))}
    </nav>
    <a href="#top" class="group flex w-fit items-center gap-2.5 rounded-full border border-secondaire px-[1.125rem] py-3 text-[14px] transition duration-300 ease-soft hover:bg-secondaire hover:text-header active:scale-95">
      Retour en haut
      <svg aria-hidden="true" viewBox="0 0 14 14" class="size-3.5 transition-transform duration-300 ease-soft group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 12V2M3 6l4-4 4 4" /></svg>
    </a>
  </div>
  <hr class="my-5 border-secondaire/25" />
  <p class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[11px] text-[#e8e6d2]">
    <span>© 2026 — Tous droits réservés</span>
    <a href="/mentions-legales" class="link-underline transition-colors duration-300 hover:text-tonique">Mentions légales</a>
    <a href="/?3d" class="embed-hide btn-sm max-lg:hidden">Version 3D</a>
  </p>
</footer>
