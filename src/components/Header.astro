---
import { nav } from '../data/content';
interface Props { current?: string; crumb?: { label: string; href?: string }[] }
const { current, crumb } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
---
<header class="sticky top-0 z-40 bg-header/75 shadow-[inset_0_0_50px_rgba(0,0,0,.2)] backdrop-blur-[0.625rem]">
  <div class="flex items-center justify-between px-5 py-3 lg:px-[3.125rem] lg:py-5">
    <p class="flex items-center gap-3 lg:gap-5">
      <a href="/accueil" class="font-titre text-2xl leading-none transition-colors duration-300 hover:text-tonique lg:text-[2rem]">Maël Brungard</a>
      {(crumb?.length || current) && <span aria-hidden="true" class="size-2.5 rounded-full bg-secondaire max-lg:hidden"></span>}
      <span class="font-tag text-xl font-light max-lg:hidden lg:text-2xl">
        {crumb
          ? crumb.map((c, i) => (<>{i > 0 && <span aria-hidden="true"> &gt; </span>}{c.href ? <a href={c.href} class="link-underline transition-colors duration-300 hover:text-tonique">{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))
          : current}
      </span>
    </p>

    <nav aria-label="Navigation principale" class="hidden items-center gap-5 font-tag text-2xl font-light lg:flex">
      {nav.map((l, i) => (<>
        {i > 0 && <span aria-hidden="true" class="size-2.5 rounded-full bg-secondaire"></span>}
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="link-underline transition-colors duration-300 hover:text-tonique aria-[current=page]:text-tonique">{l.label}</a>
      </>))}
    </nav>

    <a href="/?3d" class="embed-hide btn-sm max-xl:hidden" aria-label="Passer en version 3D">Version 3D</a>

    <button id="burger" type="button" class="group flex flex-col gap-1.5 p-2 lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
      <span class="h-0.5 w-7 bg-secondaire transition-transform duration-300 group-hover:translate-x-1"></span><span class="h-0.5 w-7 bg-secondaire transition-transform duration-300 group-hover:-translate-x-1"></span>
    </button>
  </div>
</header>

<!-- Menu mobile plein écran (maquette mobile). HORS du <header> : son flou d'arrière-plan (backdrop-filter)
     ferait de l'en-tête le repère du « position: fixed » et le menu ne couvrirait plus l'écran. -->
<div id="menu" role="dialog" aria-modal="true" aria-label="Menu" class="fixed inset-0 z-50 flex flex-col justify-center bg-tonique px-10 text-header lg:hidden">
  <button id="menu-close" type="button" class="absolute right-5 top-5 grid size-10 place-items-center rounded-full border-2 border-header text-2xl hover:bg-header hover:text-tonique" aria-label="Fermer le menu">×</button>
  <ul class="flex flex-col gap-6 font-titre text-3xl">
    {nav.map((l, i) => (
      <li style={`--i:${i}`}>
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="group flex items-center gap-3">
          <span aria-hidden="true" class="size-2.5 rounded-full bg-header transition-transform duration-300 group-hover:scale-150 group-aria-[current=page]:scale-150"></span>
          <span class="transition-transform duration-300 group-hover:translate-x-1.5">{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="absolute inset-x-0 bottom-8 text-center font-tag text-sm">Portfolio - Maël Brungard - 2026</p>
</div>

<script>
  // Ouverture animée (fondu + liens en cascade, cf. global.css #menu), focus géré pour le clavier
  const burger = document.getElementById('burger')!;
  const menu = document.getElementById('menu')!;
  const close = document.getElementById('menu-close')!;
  const set = (open: boolean) => {
    if (open === menu.hasAttribute('data-open')) return;
    menu.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? close : burger).focus({ preventScroll: true });
  };
  burger.addEventListener('click', () => set(true));
  close.addEventListener('click', () => set(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  addEventListener('pageshow', (e) => e.persisted && set(false)); // retour arrière : menu refermé
</script>
