---
import { nav } from '../data/content';
interface Props { current?: string; crumb?: { label: string; href?: string }[] }
const { current, crumb } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
---
<header class="sticky top-0 z-40 bg-header/75 shadow-[inset_0_0_50px_rgba(0,0,0,.2)] backdrop-blur-[0.625rem]">
  <div class="flex items-center justify-between px-5 py-3 lg:px-[3.125rem] lg:py-5">
    <p class="flex items-center gap-3 lg:gap-5">
      <a href="/accueil" class="font-titre text-2xl leading-none lg:text-[2rem]">Maël Brungard</a>
      {(crumb?.length || current) && <span aria-hidden="true" class="size-2.5 rounded-full bg-secondaire max-lg:hidden"></span>}
      <span class="font-tag text-xl font-light max-lg:hidden lg:text-2xl">
        {crumb
          ? crumb.map((c, i) => (<>{i > 0 && <span aria-hidden="true"> &gt; </span>}{c.href ? <a href={c.href} class="hover:text-tonique">{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))
          : current}
      </span>
    </p>

    <nav aria-label="Navigation principale" class="hidden items-center gap-5 font-tag text-2xl font-light lg:flex">
      {nav.map((l, i) => (<>
        {i > 0 && <span aria-hidden="true" class="size-2.5 rounded-full bg-secondaire"></span>}
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined} class="transition hover:text-tonique aria-[current=page]:text-tonique">{l.label}</a>
      </>))}
    </nav>

    <a href="/?3d" class="embed-hide btn-sm max-xl:hidden" aria-label="Passer en version 3D">Version 3D</a>

    <button id="burger" type="button" class="flex flex-col gap-1.5 p-2 lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
      <span class="h-0.5 w-7 bg-secondaire"></span><span class="h-0.5 w-7 bg-secondaire"></span>
    </button>
  </div>

  <!-- Menu mobile plein écran (maquette mobile) -->
  <div id="menu" hidden class="fixed inset-0 z-50 flex flex-col justify-center bg-tonique px-10 text-header">
    <button id="menu-close" type="button" class="absolute right-5 top-5 grid size-10 place-items-center rounded-full border-2 border-header text-2xl" aria-label="Fermer le menu">×</button>
    <ul class="flex flex-col gap-6 font-titre text-3xl">
      {nav.map((l) => <li><a href={l.href} class="flex items-center gap-3"><span aria-hidden="true" class="size-2.5 rounded-full bg-header"></span>{l.label}</a></li>)}
    </ul>
    <p class="absolute inset-x-0 bottom-8 text-center font-tag text-sm">Portfolio - Maël Brungard - 2026</p>
  </div>
</header>

<script>
  const burger = document.getElementById('burger')!;
  const menu = document.getElementById('menu')!;
  const set = (open: boolean) => { menu.hidden = !open; burger.setAttribute('aria-expanded', String(open)); document.body.style.overflow = open ? 'hidden' : ''; };
  burger.addEventListener('click', () => set(true));
  document.getElementById('menu-close')!.addEventListener('click', () => set(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>
