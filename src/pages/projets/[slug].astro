---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import SectionNav from '../../components/SectionNav.astro';
import Carousel from '../../components/Carousel.astro';
import { getProjects } from '../../lib/db';
import { accent } from '../../data/content';
import { rich } from '../../lib/rich';

export function getStaticPaths() {
  return getProjects().map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
// La rubrique Galerie (section, bouton de la barre d'ancres, lien du pied de page) n'existe que si le projet a des images
const sections = [
  { id: 'contexte', label: 'Contexte' },
  { id: 'processus', label: 'Processus' },
  ...(p.galerie.length ? [{ id: 'galerie', label: 'Galerie' }] : []),
];
const footerLinks = sections.map((t) => ({ label: t.label, href: `#${t.id}` }));
const label = p.context === 'Personnel' || p.context === 'Professionnel' ? p.context : 'Projet scolaire';
const plain = p.summary.replace(/\*\*/g, '');
---
<Base title={`${p.title} — Maël Brungard`} description={plain} current="Projets" footerLinks={footerLinks}
  crumb={[{ label: 'Projets', href: '/projets' }, { label: p.title }]}>
  <div class="stripes px-5 py-8 lg:grid lg:grid-cols-[18.4375rem_1fr] lg:gap-6 lg:px-[3.125rem]">
    <!-- Grand écran : le bouton Retour suit le défilement (collé sous l'en-tête) pour rester toujours visible -->
    <div class="reveal lg:sticky lg:top-[var(--header-h,5rem)] lg:self-start lg:pt-8"><a href="/projets" class="btn-sm mb-6 w-fit lg:mx-auto lg:flex">Retour</a></div>

    <!-- min-w-0 : sans ça, la colonne de grille s'élargit à la largeur de toutes les images du carrousel -->
    <article class="min-w-0 lg:max-w-[92rem]">
      <header class="flex flex-col-reverse items-start justify-between gap-6 lg:flex-row">
        <div class="max-w-[55rem] space-y-3">
          <p style="--d:0" class="reveal font-tag text-xl font-semibold uppercase text-tonique lg:text-2xl">{label}</p>
          <h1 style="--d:1" class="reveal font-titre text-4xl italic leading-tight lg:text-[4rem]">{p.title}</h1>
          <Tags tags={p.stack} accent={accent} class="reveal text-xl lg:text-2xl" />
          <p style="--d:3" class="reveal rich pt-2 text-lg font-light lg:text-2xl" set:html={rich(p.summary)} />
        </div>
        <div style="--d:2" class="reveal panel gradient-gold grid size-36 shrink-0 place-items-center rounded-3xl lg:size-[17.625rem]">
          <img src={p.logo} alt={`Logo du projet ${p.title}`} width="200" height="200" class="size-24 object-contain lg:size-[12.5rem]" />
        </div>
      </header>

      <SectionNav items={sections} label="Sections du projet" />

      <div class="space-y-16 pb-10">
        {sections.map((t) => (
          <section id={t.id} class="scroll-mt-4">
            <h2 class="mb-6 flex items-center gap-4 border-b border-tonique/40 pb-3 font-titre text-3xl lg:text-[2.25rem]">
              <span aria-hidden="true" class="size-3 rounded-full bg-tonique"></span>{t.label}
            </h2>
            {t.id === 'galerie' ? (
              <Carousel images={p.galerie} label={`Galerie du projet ${p.title}`} />
            ) : p[t.id as 'contexte' | 'processus'].length ? (
              <div class="grid gap-x-12 gap-y-8 lg:grid-cols-2">
                {p[t.id as 'contexte' | 'processus'].map((s) => (
                  <div><h3 class="h-section">{s.title}</h3><p class="rich text-lg font-light lg:text-xl" set:html={rich(s.body)} /></div>
                ))}
              </div>
            ) : (
              <p class="panel p-6 font-tag text-xl">Texte en cours de rédaction.</p>
            )}
          </section>
        ))}
      </div>
    </article>
  </div>
</Base>
