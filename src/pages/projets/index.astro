---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getSkills, getContexts } from '../../lib/db';

// Les projets viennent de la base SQLite (db/portfolio.sqlite), lue au build.
const projects = getProjects(), skills = getSkills(), contexts = getContexts();
const groups = [
  { id: 'scolaire', title: 'Projets Scolaires', list: projects.filter((p) => p.group === 'scolaire') },
  { id: 'perso-pro', title: 'Projets Personnels & Professionnels', list: projects.filter((p) => p.group === 'perso-pro') },
];
---
<Base title="Projets — Maël Brungard" description="Projets scolaires, personnels et professionnels de Maël Brungard : SkillArt, E-Commerce, Taverne Étudiante, Mini-Jeux…" current="Projets">
  <div class="stripes px-5 py-8 lg:grid lg:grid-cols-[18.4375rem_1fr] lg:gap-6 lg:px-[3.125rem]">
    <aside class="reveal lg:pt-8">
      <a href="/accueil" class="btn-sm mb-4 w-fit lg:mx-auto lg:mb-10 lg:flex">Retour</a>
      <button id="toggle-filters" type="button" class="btn-sm mb-4 lg:hidden" aria-expanded="false" aria-controls="filters">Filtrer</button>
      <form id="filters" class="panel hidden flex-col gap-3 p-5 lg:flex" aria-label="Filtrer les projets">
        <fieldset>
          <legend class="mb-2 font-titre text-lg italic lg:text-xl">Skills</legend>
          <div class="flex flex-wrap gap-2 lg:flex-col lg:px-3">
            {skills.map((s) => <button type="button" class="pill" data-skill={s} aria-pressed="false">{s}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend class="mb-2 mt-3 font-titre text-lg italic lg:text-xl">Contexte</legend>
          <div class="flex flex-wrap gap-2 lg:flex-col lg:px-3">
            {contexts.map((c) => <button type="button" class="pill" data-context={c.id} aria-pressed="false">{c.label}</button>)}
          </div>
        </fieldset>
        <button type="reset" id="reset" class="link-underline mx-auto w-fit font-tag text-lg transition-colors duration-300 hover:text-tonique">Effacer les filtres</button>
      </form>
    </aside>

    <!-- relative : repère des éléments qui sortent pendant l'animation de filtrage (épinglés en absolu) -->
    <div data-results class="relative flex flex-col gap-10">
      <h1 class="sr-only">Tous mes projets</h1>
      {groups.map((g) => (
        <section data-group aria-labelledby={`h-${g.id}`}>
          <h2 id={`h-${g.id}`} class="mb-5 font-titre text-2xl italic lg:text-[2rem]">{g.title}</h2>
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">{g.list.map((p, i) => <ProjectCard p={p} i={i} />)}</ul>
        </section>
      ))}
      <p id="empty" hidden class="panel p-6 font-tag text-xl" role="status">Aucun projet ne correspond à ces filtres.</p>
    </div>
  </div>
</Base>

<script>
  // Filtres : un projet est visible s'il a AU MOINS un des skills choisis ET correspond à un des contextes choisis.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')].map((el) => ({
    el, skills: el.dataset.skills!.split('|'), context: el.dataset.context!, // lus une seule fois
  }));
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')].map((el) => ({
    el, cards: cards.filter((c) => el.contains(c.el)),
  }));
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.pill')];
  const empty = document.getElementById('empty')!;

  const active = (attr: 'skill' | 'context') =>
    pills.filter((p) => p.getAttribute('aria-pressed') === 'true' && p.dataset[attr]).map((p) => p.dataset[attr]!);

  /* ───── Animation du filtrage (technique FLIP) ─────
     1. on mémorise la position de tout ce qui est visible ;
     2. ce qui sort est « épinglé » en absolu à sa place (il ne pèse plus dans la mise en page) et s'évanouit ;
     3. on applique le nouveau filtrage, puis chaque élément resté visible glisse de son ancienne à sa nouvelle place ;
     4. ce qui apparaît surgit en cascade. Un nouveau clic termine net l'animation en cours avant de repartir. */
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(.2, .7, .2, 1)';
  let running: Animation[] = [];
  let cleanups: (() => void)[] = [];

  const matches = (c: (typeof cards)[number], sk: string[], cx: string[]) =>
    (!sk.length || sk.some((s) => c.skills.includes(s))) && (!cx.length || cx.includes(c.context));

  const apply = () => {
    const sk = active('skill'), cx = active('context');
    const show = new Map(cards.map((c) => [c.el, matches(c, sk, cx)]));
    const groupShow = new Map(groups.map((g) => [g.el, g.cards.some((c) => show.get(c.el))]));
    const anyShown = [...show.values()].some(Boolean);

    const commit = () => {
      cards.forEach((c) => (c.el.hidden = !show.get(c.el)));
      groups.forEach((g) => (g.el.hidden = !groupShow.get(g.el)));
      empty.hidden = anyShown;
    };
    if (reduced) return commit();

    // Nouveau clic pendant une animation : on la termine net et on nettoie tout de suite (synchrone)
    running.forEach((a) => a.cancel()); running = [];
    cleanups.forEach((fn) => fn()); cleanups = [];

    // Éléments suivis : cartes, titres de rubrique, message « aucun projet »
    const heads = groups.map((g) => g.el.querySelector<HTMLElement>('h2')!);
    const tracked = [...cards.map((c) => c.el), ...heads, empty];
    const first = new Map<HTMLElement, DOMRect>();
    for (const el of tracked) if (el.offsetParent) first.set(el, el.getBoundingClientRect());

    // Ce qui sort : rubriques entières qui se vident, cartes isolées dans une rubrique qui reste, message vide
    const leaving: HTMLElement[] = [];
    groups.forEach((g) => { if (!g.el.hidden && !groupShow.get(g.el)) leaving.push(g.el); });
    cards.forEach((c) => {
      const grp = groups.find((g) => g.cards.includes(c))!;
      if (!c.el.hidden && !show.get(c.el) && groupShow.get(grp.el)) leaving.push(c.el);
    });
    if (!empty.hidden && anyShown) leaving.push(empty);

    // Épingler ce qui sort à sa position actuelle
    const box = results.getBoundingClientRect();
    const savedStyle = new Map(leaving.map((el) => [el, el.getAttribute('style')]));
    for (const el of leaving) {
      const r = el.getBoundingClientRect();
      Object.assign(el.style, {
        position: 'absolute', top: `${r.top - box.top}px`, left: `${r.left - box.left}px`,
        width: `${r.width}px`, height: `${r.height}px`, margin: '0', pointerEvents: 'none', zIndex: '0',
      });
    }

    // Nouvel état (les éléments épinglés restent affichés jusqu'à la fin de leur sortie)
    cards.forEach((c) => { if (!leaving.includes(c.el) && !leaving.some((l) => l.contains(c.el))) c.el.hidden = !show.get(c.el); });
    groups.forEach((g) => { if (groupShow.get(g.el)) g.el.hidden = false; });
    if (!anyShown) empty.hidden = false;

    // Sorties : rétrécit, s'estompe et se floute
    for (const el of leaving) {
      const a = el.animate(
        [{ opacity: 1, transform: 'none', filter: 'blur(0)' }, { opacity: 0, transform: 'scale(.82) translateY(10px)', filter: 'blur(6px)' }],
        { duration: 320, easing: 'cubic-bezier(.4, 0, 1, 1)', fill: 'forwards' },
      );
      let done = false;
      const cleanup = () => {
        if (done) return; done = true;
        a.cancel();
        const st = savedStyle.get(el); st == null ? el.removeAttribute('style') : el.setAttribute('style', st); // styles d'origine (ex. --d)
        el.hidden = true;
        if (el.matches('[data-group]')) el.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => (c.hidden = !show.get(c)));
      };
      a.finished.then(cleanup, () => {}); // annulée par un nouveau clic : nettoyage déjà fait via cleanups
      cleanups.push(cleanup);
      running.push(a);
    }

    // Déplacements et entrées
    let n = 0;
    for (const el of tracked) {
      if (leaving.includes(el) || leaving.some((l) => l.contains(el)) || !el.offsetParent) continue;
      const last = el.getBoundingClientRect();
      const was = first.get(el);
      if (was) {
        const dx = was.left - last.left, dy = was.top - last.top;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) continue;
        running.push(el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
          { duration: 650, easing: EASE },
        ));
      } else {
        running.push(el.animate(
          [{ opacity: 0, transform: 'translateY(26px) scale(.86)', filter: 'blur(8px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }],
          { duration: 600, delay: 140 + n++ * 55, easing: EASE, fill: 'backwards' },
        ));
      }
    }
  };

  pills.forEach((p) => p.addEventListener('click', () => { p.setAttribute('aria-pressed', String(p.getAttribute('aria-pressed') !== 'true')); apply(); }));
  document.getElementById('filters')!.addEventListener('reset', () => { pills.forEach((p) => p.setAttribute('aria-pressed', 'false')); setTimeout(apply); });

  const toggle = document.getElementById('toggle-filters')!;
  const panel = document.getElementById('filters')!;
  toggle.addEventListener('click', () => {
    const open = panel.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
